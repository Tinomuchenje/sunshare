# SunShare environment variables. Copy to .env.local and fill in what you need.
# With nothing set, the app runs fully in demo mode with no network access.

# --- PayPal (sandbox) ---
# Set both to switch PayPal from demo mode to the PayPal sandbox
# (https://api-m.sandbox.paypal.com: Orders v2 for checkout, Payouts v1 for monthly payouts).
# Create a sandbox REST app at https://developer.paypal.com/dashboard/applications/sandbox.
# Payouts must be enabled for the sandbox business account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- AI (Anthropic Claude) ---
# Set to let Claude write the vetting and monitoring narratives and drive the
# investor agent with tool calls. Numbers are always computed in code.
ANTHROPIC_API_KEY=
# Alternative: an OpenAI key (used when ANTHROPIC_API_KEY is not set). Default model: gpt-4o-mini
OPENAI_API_KEY=
# Optional. Model name for the Messages API. Default: claude-sonnet-5-5
AI_MODEL=
